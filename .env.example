# Copy to .env.local and fill in. Never commit real values.

# Matches docker-compose.yml (local development only).
DATABASE_URL=postgres://aic:aic@127.0.0.1:5495/ai_mac

# Required. Signs the session cookie and keys the sign-in code hashes.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Needed only to generate new apps, "Improve" and aic.ask.
# The default apps work without it.
OPENAI_API_KEY=

# Production only. In development the sign-in code is printed in the terminal.
# MAIL_FROM must be an address on a domain you have verified in Resend.
# RESEND_API_KEY=
# MAIL_FROM="AI Mac <noreply@example.com>"

# Admin panel at /admin. Comma separated addresses allowed to sign in there (with an emailed code).
# Leave unset to turn the panel off.
# ADMIN_EMAILS=you@example.com

# Optional
# AIC_CODE_MODEL=gpt-5.5
# AIC_CHAT_MODEL=gpt-5.4-mini
# AIC_IMAGE_MODEL=gpt-image-2
# DEV_ORIGINS=
